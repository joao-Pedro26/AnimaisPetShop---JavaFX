<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.AnimalController">
    <children>
        <HBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <VBox prefWidth="320.0" spacing="10.0" style="-fx-background-color: #1E1E1E; -fx-background-radius: 10; -fx-padding: 20;">
                    <children>

                        <Label text="Cadastro de Animais" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="15.0" /> </VBox.margin>
                        </Label>

                        <Label text="Nome:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <TextField fx:id="txtNome" prefHeight="35.0" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Espécie:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <TextField fx:id="txtEspecie" prefHeight="35.0" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Raça:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <TextField fx:id="txtRaca" prefHeight="35.0" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Idade:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <TextField fx:id="txtIdade" prefHeight="35.0" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Peso:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <TextField fx:id="txtPeso" prefHeight="35.0" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Label text="Sexo:" textFill="#E0E0E0">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <ComboBox fx:id="cbSexo" prefHeight="35.0" prefWidth="300.0" promptText="Selecione" style="-fx-background-color: #121212; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#salvar" prefHeight="38.0" prefWidth="90.0" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Salvar">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button mnemonicParsing="false" onAction="#excluir" prefHeight="38.0" prefWidth="90.0" style="-fx-background-color: transparent; -fx-text-fill: #E74C3C; -fx-border-color: #E74C3C; -fx-border-radius: 5; -fx-cursor: hand;" text="Excluir">
                                    <font><Font size="13.0" /></font>
                                </Button>

                                <Button mnemonicParsing="false" onAction="#limpar" prefHeight="38.0" prefWidth="90.0" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: #666666; -fx-border-radius: 5; -fx-cursor: hand;" text="Limpar">
                                    <font><Font size="13.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #1E1E1E; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tabelaAnimais" style="-fx-base: #1E1E1E; -fx-control-inner-background: #1E1E1E; -fx-table-cell-border-color: #333333; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                                <TableColumn fx:id="colNome" prefWidth="130.0" text="Nome" />
                                <TableColumn fx:id="colEspecie" prefWidth="100.0" text="Espécie" />
                                <TableColumn fx:id="colRaca" prefWidth="130.0" text="Raça" />
                                <TableColumn fx:id="colIdade" prefWidth="60.0" text="Idade" />
                                <TableColumn fx:id="colPeso" prefWidth="60.0" text="Peso" />
                                <TableColumn fx:id="colSexo" prefWidth="50.0" text="Sexo" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>